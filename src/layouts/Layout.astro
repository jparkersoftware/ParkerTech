---
import '../styles/global.css';
import { site } from '../data/site';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  /** Page title; the brand is appended. Defaults to the homepage title. */
  title?: string;
  description?: string;
  /** Page-specific social-share image (path under public/). */
  ogImage?: string;
  /** Extra JSON-LD objects for this page (Product, Article, ...). */
  schema?: Record<string, unknown>[];
}

const { title = site.title, description = site.description, ogImage: ogImageProp, schema = [] } =
  Astro.props;
const pageTitle = `${title} | ${site.brand}`;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(ogImageProp ?? '/og-image.png', Astro.site ?? site.url).href;

const { company } = site;
const [locality, region] = site.location.split(',').map((s) => s.trim());

const organization = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness'],
  '@id': `${site.url}/#organization`,
  name: site.brand,
  // Registered details are only advertised once they're actually filled in.
  ...(company.legalName ? { legalName: company.legalName } : {}),
  ...(company.number
    ? {
        identifier: {
          '@type': 'PropertyValue',
          propertyID: 'Companies House registration number',
          value: company.number,
        },
      }
    : {}),
  ...(company.vatNumber ? { vatID: company.vatNumber } : {}),
  address:
    company.registeredOffice.length > 0
      ? {
          '@type': 'PostalAddress',
          streetAddress: company.registeredOffice.slice(0, -1).join(', '),
          postalCode: company.registeredOffice[company.registeredOffice.length - 1],
          addressCountry: 'GB',
        }
      : {
          '@type': 'PostalAddress',
          addressLocality: locality,
          addressRegion: region,
          addressCountry: 'GB',
        },
  description: site.description,
  url: site.url,
  email: site.email,
  ...(site.phone ? { telephone: site.phone } : {}),
  logo: new URL('/favicon.svg', site.url).href,
  image: new URL('/og-image.png', site.url).href,
  founder: { '@type': 'Person', name: site.founder },
  areaServed: { '@type': 'Country', name: 'GB' },
  knowsAbout: [
    'Educational technology',
    'School management software',
    'Arbor MIS migration',
    'Microsoft Power Platform',
    'Power BI',
    'SharePoint',
    'Wonde integration',
    'Cloud-first infrastructure',
    'School IT support',
  ],
};

const fonts =
  'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,600&display=swap';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — ${site.brand}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — loaded without blocking first paint -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fonts} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fonts} /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(organization)} is:inline />
    {schema.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} is:inline />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <ConsentBanner />
  </body>
</html>
