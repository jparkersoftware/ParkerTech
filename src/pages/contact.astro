---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const { company } = site;
---

<Layout
  title="Contact us"
  description="Talk to ParkerTech about software, data or IT support for your school or trust. We work to purchase orders and reply within 1–2 working days."
>
  <Nav />
  <main id="main" tabindex="-1">
    <PageHero
      crumbs={[{ href: '/contact', label: 'Contact' }]}
      title="Talk to us about your school"
      lead={`Tell us what you need and we will reply with next steps. We work to purchase orders and can provide a data processing agreement and references on request.`}
    />

    <section class="section">
      <div class="container contact-grid">
        <div>
          <h2 class="contact-form-title">Send an enquiry</h2>
          <EnquiryForm />
        </div>

        <aside class="contact-details" aria-labelledby="details-title">
          <h2 id="details-title">Contact details</h2>
          <ul class="details-list">
            <li>
              <Icon name="email" size={20} />
              <span>
                <span class="details-label">Email</span>
                <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
              </span>
            </li>
            {
              site.phone && (
                <li>
                  <Icon name="phone" size={20} />
                  <span>
                    <span class="details-label">Phone</span>
                    <a class="text-link" href={`tel:${site.phone.replace(/\s/g, '')}`}>
                      {site.phone}
                    </a>
                  </span>
                </li>
              )
            }
            <li>
              <Icon name="map-pin" size={20} />
              <span>
                <span class="details-label">
                  {company.registeredOffice.length > 0 ? 'Registered office' : 'Based in'}
                </span>
                {company.registeredOffice.length > 0 ? company.registeredOffice.join(', ') : site.location}
              </span>
            </li>
            <li>
              <Icon name="clock" size={20} />
              <span>
                <span class="details-label">Response time</span>
                {site.responseTime}
              </span>
            </li>
          </ul>
          <p class="details-note">
            Raising a purchase order? Our{' '}
            <a class="text-link" href="/about/working-with-schools">working with schools</a> page has
            the details your finance team will need.
          </p>
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .contact-form-title,
  .contact-details h2 {
    margin-bottom: 1.25rem;
    font-size: 1.5rem;
  }
  .contact-details {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
    border: 1px solid var(--border);
  }
  .details-list {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .details-list li {
    display: flex;
    gap: 0.85rem;
  }
  .details-list :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2rem;
    color: var(--accent);
  }
  .details-label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .details-list a {
    word-break: break-word;
  }
  .details-note {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-strong);
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
