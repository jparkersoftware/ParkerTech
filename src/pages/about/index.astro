---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import Testimonials from '../../components/Testimonials.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';

const { about } = site;
---

<Layout
  title="About us"
  description="ParkerTech is a Rochester, Kent company building school software, MIS data integrations and IT support for UK schools and trusts. Founded by a former teacher."
>
  <Nav />
  <main id="main" tabindex="-1">
    <PageHero crumbs={[{ href: '/about', label: 'About' }]} eyebrow="About" title={about.title} />

    <section class="section">
      <div class="container about-grid">
        <div class="prose about-intro">
          {about.intro.map((para) => <p>{para}</p>)}
        </div>
        <aside class="about-links">
          <a class="card about-link" href="/about/founder">
            <span class="about-link-title">Our founder</span>
            <span>Joseph Parker's background in teaching, school IT and software.</span>
            <Icon name="arrow-right" size={18} />
          </a>
          <a class="card about-link" href="/about/working-with-schools">
            <span class="about-link-title">Working with schools</span>
            <span>Data hosting, DPA, invoicing and the details finance teams ask for.</span>
            <Icon name="arrow-right" size={18} />
          </a>
        </aside>
      </div>
    </section>

    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <h2>What we believe about school technology</h2>
        </div>
        <div class="grid-2">
          {
            about.beliefs.map((b) => (
              <div class="card">
                <h3>{b.title}</h3>
                <p class="belief-text">{b.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <ProcessSteps />
    <Testimonials />
    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about-intro p {
    font-size: 1.125rem;
  }
  .about-intro p:first-child {
    color: var(--text);
  }
  .about-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .about-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--text-muted);
    transition: border-color 0.15s var(--ease);
  }
  .about-link:hover {
    border-color: var(--accent);
  }
  .about-link-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--heading);
  }
  .about-link :global(svg) {
    margin-top: 0.4rem;
    color: var(--accent);
  }
  .belief-text {
    margin-top: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
