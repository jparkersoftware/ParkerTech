---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { site } from '../../data/site';

const person = site.founderProfile;
const dbs = site.credentials.items.find((item) => item.label === 'Safeguarding')?.value;
const initials = person.name
  .split(' ')
  .map((part) => part[0])
  .join('');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  jobTitle: 'Founder',
  worksFor: { '@id': `${site.url}/#organization` },
  ...(person.photo ? { image: new URL(person.photo, site.url).href } : {}),
};
---

<Layout
  title={`${person.name}, founder`}
  description="Joseph Parker founded ParkerTech after a decade teaching in schools, combining classroom experience with school IT management and software development."
  schema={[schema]}
>
  <Nav />
  <main id="main" tabindex="-1">
    <PageHero
      crumbs={[
        { href: '/about', label: 'About' },
        { href: '/about/founder', label: 'Our founder' },
      ]}
      eyebrow="Our founder"
      title={person.name}
      lead={person.role}
    />

    <section class="section">
      <div class="container founder">
        <div class="founder-photo">
          {
            person.photo ? (
              <img src={person.photo} alt={`${person.name}, ${person.role}`} width="800" height="800" />
            ) : (
              <span class="founder-initials" aria-hidden="true">
                {initials}
              </span>
            )
          }
        </div>
        <div class="founder-text">
          <div class="prose">
            {person.bio.map((para) => <p>{para}</p>)}
            {dbs && <p class="founder-dbs">{dbs}.</p>}
          </div>
          {
            person.quotes.map((quote) => (
              <figure class="pull-quote">
                <blockquote>
                  <p>“{quote}”</p>
                </blockquote>
                <figcaption>{person.name}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand />
  </main>
  <Footer />
</Layout>

<style>
  .founder {
    display: grid;
    grid-template-columns: 320px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .founder-photo img,
  .founder-initials {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-lg);
  }
  .founder-photo img {
    object-fit: cover;
  }
  .founder-initials {
    display: grid;
    place-items: center;
    background: var(--accent-tint);
    border: 1px solid var(--accent-line);
    font-family: var(--font-serif);
    font-size: 5rem;
    font-weight: 600;
    color: var(--accent-deep);
  }
  .founder-text .prose p {
    font-size: 1.125rem;
  }
  .founder-text .prose p:first-child {
    color: var(--text);
  }
  .founder-dbs {
    font-weight: 600;
  }
  .pull-quote {
    margin: 2rem 0 0;
    padding-left: 1.25rem;
    border-left: 4px solid var(--accent);
    max-width: 60ch;
  }
  .pull-quote p {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.5;
    color: var(--heading);
  }
  .pull-quote figcaption {
    margin-top: 0.6rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .founder {
      grid-template-columns: minmax(0, 1fr);
    }
    .founder-photo {
      max-width: 240px;
    }
  }
</style>
