---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, type Project } from '../../data/projects';
import { serviceBySlug } from '../../data/services';
import { products } from '../../data/products';
import { site } from '../../data/site';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const service = serviceBySlug(project.service);
const product = products.find((p) => p.slug === project.product);
const client = [project.client.type, project.client.region].filter(Boolean).join(', ');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `${project.title} case study`,
  description: project.summary,
  about: project.title,
  dateCreated: project.year,
  author: { '@id': `${site.url}/#organization` },
  publisher: { '@id': `${site.url}/#organization` },
  ...(project.cover ? { image: new URL(project.cover, site.url).href } : {}),
};
---

<Layout
  title={`${project.title} case study`}
  description={project.summary}
  ogImage={`/og/${project.slug}.png`}
  schema={[schema]}
>
  <Nav />
  <main id="main" tabindex="-1">
    <article>
      <header class="cs-hero">
        <div class="container">
          <Breadcrumbs
            items={[
              { href: '/case-studies', label: 'Case studies' },
              { href: `/case-studies/${project.slug}`, label: project.title },
            ]}
          />
          <div class="cs-hero-text">
            <span class="badge" data-kind={project.kind}>{project.kind}</span>
            <h1>{project.title}</h1>
            <p class="cs-summary">{project.summary}</p>
          </div>
        </div>
      </header>

      <div class="container cs-layout">
        <aside class="cs-facts" aria-label="Project details">
          <dl>
            <div>
              <dt>Client</dt>
              <dd>{client}</dd>
            </div>
            <div>
              <dt>Year</dt>
              <dd>{project.year}</dd>
            </div>
            <div>
              <dt>Service</dt>
              <dd><a class="text-link" href={`/services/${service.slug}`}>{service.navLabel}</a></dd>
            </div>
            <div>
              <dt>Technology used</dt>
              <dd>
                <ul class="tag-row">
                  {project.tech.map((t) => <li>{t}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
        </aside>

        <div class="cs-body">
          {
            project.cover && (
              <BrowserFrame src={project.cover} alt={project.coverAlt ?? `${project.title} screenshot`} eager />
            )
          }

          <section>
            <h2>The challenge</h2>
            <p>{project.challenge}</p>
          </section>

          <section>
            <h2>What we built</h2>
            <ul class="tick-list">
              {project.built.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="cs-result">
            <h2>The result</h2>
            <p>{project.result}</p>
          </section>

          {
            project.quote && (
              <figure class="cs-quote">
                <blockquote>
                  <p>“{project.quote.text}”</p>
                </blockquote>
                <figcaption>
                  {project.quote.name}, {project.quote.role}
                </figcaption>
              </figure>
            )
          }

          {
            project.gallery && (
              <section>
                <h2>A closer look</h2>
                {project.gallery.map((shot) => (
                  <figure class="cs-shot">
                    <BrowserFrame src={shot.src} alt={shot.caption} />
                    <figcaption>{shot.caption}</figcaption>
                  </figure>
                ))}
              </section>
            )
          }

          {
            product && (
              <p class="cs-product">
                {product.name} is available to any school.{' '}
                <a class="text-link" href={`/products/${product.slug}`}>
                  See the {product.name} product page
                </a>
              </p>
            )
          }
        </div>
      </div>
    </article>

    <CtaBand title="Interested in something similar?" />
  </main>
  <Footer />
</Layout>

<style>
  .cs-hero {
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(2.5rem, 5vw, 3.5rem);
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .cs-hero-text {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
    max-width: 68ch;
  }
  .cs-hero-text h1 {
    margin-top: 0.75rem;
  }
  .cs-summary {
    margin-top: 0.9rem;
    font-size: 1.1875rem;
    color: var(--text-muted);
  }

  .cs-layout {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem);
  }
  .cs-facts dl {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-alt);
  }
  .cs-facts dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cs-facts dd {
    margin-top: 0.25rem;
    color: var(--text);
  }
  .cs-facts .tag-row {
    margin-top: 0.4rem;
  }
  .cs-facts .tag-row li {
    background: #fff;
  }

  .cs-body {
    max-width: 68ch;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 2.75rem);
  }
  .cs-body h2 {
    margin-bottom: 0.75rem;
  }
  .cs-body section > p {
    color: var(--text-muted);
  }
  .cs-result {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-left: 4px solid var(--teal);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--teal-tint);
  }
  .cs-body .cs-result > p {
    color: var(--text);
  }

  .cs-quote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 4px solid var(--accent);
  }
  .cs-quote p {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--heading);
  }
  .cs-quote figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .cs-shot {
    margin: 0;
  }
  .cs-shot + .cs-shot {
    margin-top: 1.5rem;
  }
  .cs-shot figcaption {
    margin-top: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-dim);
  }
  .cs-product {
    font-weight: 500;
  }

  @media (max-width: 860px) {
    .cs-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .cs-facts dl {
      position: static;
    }
  }
</style>
