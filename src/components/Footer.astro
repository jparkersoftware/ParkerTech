---
import { site } from '../data/site';
import { services } from '../data/services';
import { products } from '../data/products';

const year = new Date().getFullYear();
const { company } = site;

// Companies Act 2006 trading disclosures. The statutory line renders only
// once the registered name and number are filled in, so it is never half-complete.
const showLegal = Boolean(company.legalName && company.number);
const statutory = [
  `${company.legalName} is a company registered in ${company.placeOfRegistration}, company no. ${company.number}.`,
  company.registeredOffice.length > 0 && `Registered office: ${company.registeredOffice.join(', ')}.`,
  company.vatNumber && `VAT no. ${company.vatNumber}.`,
  company.icoNumber && `Registered with the ICO, reference ${company.icoNumber}.`,
]
  .filter(Boolean)
  .join(' ');

const companyLinks = [
  { href: '/about', label: 'About' },
  { href: '/case-studies', label: 'Case studies' },
  { href: '/about/working-with-schools', label: 'Working with schools' },
  { href: '/contact', label: 'Contact' },
];
const legalLinks = [
  { href: '/privacy', label: 'Privacy & cookies' },
  { href: '/accessibility', label: 'Accessibility statement' },
];
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a class="brand" href="/" aria-label={`${site.brand} home`}>
          Parker<span class="brand-accent">Tech</span>
        </a>
        <p class="footer-tagline">Software, data and IT support for UK schools.</p>
        <ul class="footer-contact">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          {site.phone && <li><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></li>}
          <li>{site.location}</li>
        </ul>
      </div>

      <div class="footer-cols">
        <nav class="footer-col" aria-label="Services">
          <p class="footer-col-title">Services</p>
          {services.map((s) => <a href={`/services/${s.slug}`}>{s.navLabel}</a>)}
        </nav>
        <nav class="footer-col" aria-label="Products">
          <p class="footer-col-title">Products</p>
          {
            products.map((p) => (
              <a href={p.liveUrl} target="_blank" rel="noopener noreferrer">
                {p.name}
                <span class="visually-hidden"> (opens in new tab)</span>
                <span class="footer-ext" aria-hidden="true">↗</span>
              </a>
            ))
          }
        </nav>
        <nav class="footer-col" aria-label="Company">
          <p class="footer-col-title">Company</p>
          {companyLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <nav class="footer-col" aria-label="Legal">
          <p class="footer-col-title">Legal</p>
          {legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      {showLegal && <p class="footer-legal">{statutory}</p>}
      <p>© {year} {company.legalName || site.brand}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--dark);
    color: var(--on-dark-muted);
    padding-block: clamp(3rem, 6vw, 4.5rem) 2rem;
    font-size: 0.95rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: clamp(2rem, 5vw, 4rem);
  }

  .brand {
    font-weight: 800;
    font-size: 1.375rem;
    letter-spacing: -0.03em;
    color: #fff;
  }
  .brand-accent {
    color: #93c5fd;
  }
  .footer-tagline {
    margin-top: 0.75rem;
    max-width: 30ch;
  }
  .footer-contact {
    margin-top: 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .footer-contact a {
    color: #fff;
    font-weight: 500;
  }
  .footer-contact a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer-col-title {
    margin-bottom: 0.2rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .footer-col a {
    width: fit-content;
    color: var(--on-dark-muted);
    transition: color 0.15s var(--ease);
  }
  .footer-col a:hover {
    color: #fff;
  }
  .footer-ext {
    margin-left: 0.2rem;
    font-size: 0.85em;
  }
  .footer a:focus-visible {
    outline-color: #93c5fd;
  }

  .footer-bottom {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--dark-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }
  .footer-legal {
    max-width: 90ch;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .footer-cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
</style>
