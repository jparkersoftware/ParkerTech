---
import { site } from '../data/site';

const { credentials, company } = site;

interface Credential {
  label: string;
  value: string;
  note: string;
}

// The registered rows are built from the `company` block, so they can never
// drift out of step with the statutory notice in the footer.
const companyNote = [
  company.number && `Company no. ${company.number}`,
  company.placeOfRegistration && `registered in ${company.placeOfRegistration}`,
]
  .filter(Boolean)
  .join(', ');

const derived: Credential[] = [
  { label: 'Company', value: company.legalName, note: companyNote && `${companyNote}.` },
  {
    label: 'VAT',
    value: company.vatNumber && `VAT no. ${company.vatNumber}`,
    note: 'VAT is shown separately on every invoice.',
  },
  {
    label: 'Data protection',
    value: company.icoNumber && `ICO no. ${company.icoNumber}`,
    note: 'Registered with the Information Commissioner’s Office as a data controller.',
  },
];

// Anything without a value is dropped — an unfinished row is worse than no row.
const items: Credential[] = [...derived, ...credentials.items].filter((item) => item.value);

// NOTE: the reveal-delay style attribute below is written as a concatenation on
// purpose. A template literal in an attribute nested inside the surrounding
// `items.length > 0 &&` expression hangs the Astro compiler — the build stalls
// indefinitely with no output at all. Don't "tidy" it back into a backtick.
---

{
  items.length > 0 && (
    <section class="section credentials" id="credentials">
      <div class="container">
        <div class="section-head" data-reveal>
          <span class="eyebrow">04 — Working with us</span>
          <h2 class="section-title">{credentials.title}</h2>
          <p class="section-intro">{credentials.intro}</p>
        </div>

        <ul class="cred-grid">
          {items.map((item, i) => (
            <li class="cred" data-reveal style={'--reveal-delay:' + i * 70 + 'ms'}>
              <span class="cred-label">{item.label}</span>
              <p class="cred-value">{item.value}</p>
              <p class="cred-note">{item.note}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .cred-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: clamp(0.9rem, 2vw, 1.25rem);
    list-style: none;
    padding: 0;
  }

  .cred {
    position: relative;
    padding: 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    transition: border-color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .cred:hover {
    border-color: var(--accent-line);
    transform: translateY(-3px);
  }

  .cred-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
  .cred-value {
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .cred-note {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .cred:hover {
      transform: none;
    }
  }
</style>
