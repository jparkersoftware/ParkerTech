---
import { site } from '../data/site';
import Icon, { type IconName } from './Icon.astro';
---

<section class="trust" aria-label="Working with ParkerTech">
  <ul class="container trust-list">
    {
      site.trust.map((item) => (
        <li>
          <span class="trust-icon">
            <Icon name={item.icon as IconName} size={20} />
          </span>
          {item.label}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    border-block: 1px solid var(--border);
    background: #fff;
  }
  .trust-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem var(--gutter);
    padding-block: 1.4rem;
  }
  .trust-list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--heading);
  }
  .trust-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .trust-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .trust-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
