---
import Breadcrumbs from './Breadcrumbs.astro';
import BrowserFrame from './BrowserFrame.astro';

/** The header block for every page below Home: breadcrumbs, H1, lead and optional image. */
interface Props {
  crumbs: { href: string; label: string }[];
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: { src: string; alt: string };
}
const { crumbs, eyebrow, title, lead, image } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <Breadcrumbs items={crumbs} />
    <div class:list={['page-hero-grid', { 'has-image': image }]}>
      <div class="page-hero-text">
        {eyebrow && <span class="eyebrow">{eyebrow}</span>}
        <h1>{title}</h1>
        {lead && <p class="page-hero-lead">{lead}</p>}
        <slot />
      </div>
      {image && <BrowserFrame src={image.src} alt={image.alt} eager />}
    </div>
  </div>
</section>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 3vw, 2rem) clamp(3rem, 6vw, 4.5rem);
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
  }
  .page-hero-grid {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  .page-hero-grid.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .page-hero-text {
    max-width: 68ch;
  }
  .page-hero-lead {
    margin-top: 1rem;
    font-size: 1.1875rem;
    color: var(--text-muted);
  }
  .page-hero-text :global(.btn-row) {
    margin-top: 1.75rem;
  }

  @media (max-width: 900px) {
    .page-hero-grid.has-image {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
