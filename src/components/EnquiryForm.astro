---
import { site } from '../data/site';
import Icon from './Icon.astro';

const helpOptions = ['Software products', 'Bespoke build', 'IT support', 'Not sure'];
---

<div class="enquiry">
  <!-- Posts straight to Web3Forms if JavaScript is off; the script below takes over when it's on -->
  <form
    class="enquiry-form"
    id="enquiry-form"
    action="https://api.web3forms.com/submit"
    method="POST"
    data-email={site.email}
    novalidate
  >
    <!-- Web3Forms config: submissions are emailed to the key's owner -->
    <input type="hidden" name="access_key" value={site.web3formsKey} />
    <input type="hidden" name="subject" value="New enquiry from parkertech.co.uk" />
    <input type="hidden" name="from_name" value="ParkerTech website" />
    <!-- honeypot: hidden from people, catches bots -->
    <input type="checkbox" name="botcheck" class="hp-field" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="field-row">
      <div class="field">
        <label for="ef-name">Name</label>
        <input id="ef-name" name="name" type="text" required autocomplete="name" aria-describedby="ef-name-err" />
        <p class="field-error" id="ef-name-err" data-message="Enter your name"></p>
      </div>
      <div class="field">
        <label for="ef-school">School or trust</label>
        <input id="ef-school" name="school" type="text" required autocomplete="organization" aria-describedby="ef-school-err" />
        <p class="field-error" id="ef-school-err" data-message="Enter your school or trust"></p>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="ef-role">Role</label>
        <input id="ef-role" name="role" type="text" required autocomplete="organization-title" aria-describedby="ef-role-hint ef-role-err" />
        <p class="field-hint" id="ef-role-hint">For example, business manager or deputy head</p>
        <p class="field-error" id="ef-role-err" data-message="Enter your role"></p>
      </div>
      <div class="field">
        <label for="ef-email">Email</label>
        <input id="ef-email" name="email" type="email" required autocomplete="email" aria-describedby="ef-email-err" />
        <p class="field-error" id="ef-email-err" data-message="Enter an email address, like name@school.sch.uk"></p>
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <label for="ef-phone">Phone <span class="field-optional">(optional)</span></label>
        <input id="ef-phone" name="phone" type="tel" autocomplete="tel" />
      </div>
      <div class="field">
        <label for="ef-help">What do you need help with?</label>
        <select id="ef-help" name="help_with" required aria-describedby="ef-help-err">
          <option value="">Choose one</option>
          {helpOptions.map((option) => <option value={option}>{option}</option>)}
        </select>
        <p class="field-error" id="ef-help-err" data-message="Choose what you need help with"></p>
      </div>
    </div>

    <div class="field">
      <label for="ef-message">Message</label>
      <textarea id="ef-message" name="message" rows="6" required aria-describedby="ef-message-err"></textarea>
      <p class="field-error" id="ef-message-err" data-message="Tell us a little about what you need"></p>
    </div>

    <button type="submit" class="btn btn-primary enquiry-submit">
      <span class="submit-label">Send enquiry</span>
      <Icon name="arrow-right" size={18} />
    </button>
    <p class="enquiry-note">{site.responseTime} Your details are used only to reply to you — see our <a class="text-link" href="/privacy">privacy policy</a>.</p>

    <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
  </form>

  <div class="form-success" id="form-success" tabindex="-1" hidden>
    <span class="form-success-icon"><Icon name="check" size={26} /></span>
    <h2>Enquiry sent</h2>
    <p>Thank you. {site.responseTime}</p>
  </div>
</div>

<style>
  .enquiry {
    padding: clamp(1.25rem, 3.5vw, 2rem);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
  }
  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 1.25rem;
  }
  .field {
    margin-bottom: 1.1rem;
  }
  .field label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--heading);
  }
  .field-optional {
    font-weight: 400;
    color: var(--text-dim);
  }
  .field-hint {
    margin-top: 0.3rem;
    font-size: 0.85rem;
    color: var(--text-dim);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.85rem;
    border-radius: var(--radius-sm);
    background: #fff;
    border: 1.5px solid var(--border-strong);
    font-size: 1rem;
    color: var(--text);
    transition: border-color 0.15s var(--ease), box-shadow 0.15s var(--ease);
  }
  .field textarea {
    resize: vertical;
    min-height: 140px;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-line);
  }
  .field [aria-invalid='true'] {
    border-color: #b91c1c;
  }
  .field-error {
    margin-top: 0.3rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #b91c1c;
  }
  .field-error:empty {
    display: none;
  }

  /* honeypot — visually removed, still in the DOM for bots */
  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .enquiry-submit {
    width: 100%;
    margin-top: 0.4rem;
  }
  .enquiry-submit:disabled {
    opacity: 0.7;
    cursor: progress;
  }
  .enquiry-note {
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .form-status {
    margin-top: 0.75rem;
    font-size: 0.95rem;
  }
  .form-status:empty {
    display: none;
  }
  .form-status[data-kind='error'] {
    color: #b91c1c;
  }

  .form-success {
    text-align: center;
    padding: 2rem 1rem;
  }
  .form-success[hidden] {
    display: none;
  }
  .form-success-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 1rem;
    border-radius: 50%;
    background: #ecfdf5;
    color: #047857;
  }
  .form-success p {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .field-row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const statusEl = document.getElementById('form-status') as HTMLElement;
  const successEl = document.getElementById('form-success') as HTMLElement;
  const submitBtn = form.querySelector('.enquiry-submit') as HTMLButtonElement;
  const labelEl = submitBtn.querySelector('.submit-label') as HTMLElement;
  const email = form.dataset.email ?? '';

  // Links like /contact?topic=Software%20products pre-select the help option.
  const topic = new URLSearchParams(window.location.search).get('topic');
  const helpSelect = form.querySelector<HTMLSelectElement>('select[name="help_with"]');
  if (topic && helpSelect && Array.from(helpSelect.options).some((o) => o.value === topic)) {
    helpSelect.value = topic;
  }

  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
  const fields = Array.from(form.querySelectorAll<Field>('[required]'));

  // Show or clear one field's inline error; returns whether it's valid.
  const check = (field: Field) => {
    const error = document.getElementById(`${field.id}-err`);
    const valid = field.checkValidity();
    field.setAttribute('aria-invalid', String(!valid));
    if (error) error.textContent = valid ? '' : (error.dataset.message ?? '');
    return valid;
  };

  fields.forEach((field) => {
    field.addEventListener('blur', () => {
      if (field.value) check(field);
    });
    field.addEventListener('input', () => {
      if (field.getAttribute('aria-invalid') === 'true') check(field);
    });
  });

  const setStatus = (message: string, kind: 'error' | '') => {
    statusEl.textContent = message;
    statusEl.dataset.kind = kind;
  };

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const invalid = fields.filter((field) => !check(field));
    if (invalid.length > 0) {
      invalid[0].focus();
      return;
    }

    submitBtn.disabled = true;
    labelEl.textContent = 'Sending…';
    setStatus('', '');

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const json = await response.json().catch(() => null);

      if (response.ok && json?.success) {
        form.hidden = true;
        successEl.hidden = false;
        form.reset();
        // move focus so screen-reader users hear the confirmation
        successEl.focus();
      } else {
        const message = json?.message ?? 'Something went wrong sending your enquiry.';
        setStatus(`${message} You can also email us at ${email}.`, 'error');
      }
    } catch {
      setStatus(`Network error. Please email us at ${email}.`, 'error');
    } finally {
      submitBtn.disabled = false;
      labelEl.textContent = 'Send enquiry';
    }
  });
</script>
