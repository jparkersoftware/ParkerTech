---
import { site } from '../data/site';

/** Quote blocks, up to three in a row; never a carousel. */
interface Props {
  title?: string;
}
const { title = 'What school leaders say' } = Astro.props;
const quotes = site.testimonials.slice(0, 3);
const initials = (name: string) =>
  name
    .split(' ')
    .map((part) => part[0])
    .join('')
    .slice(0, 2);
---

{
  quotes.length > 0 && (
    <section class="section section-alt testimonials" id="testimonials">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Testimonials</span>
          <h2>{title}</h2>
        </div>
        <div class:list={['t-grid', { 'is-single': quotes.length === 1 }]}>
          {quotes.map((t) => (
            <figure class="t-card">
              <blockquote>
                <p>“{t.quote}”</p>
              </blockquote>
              <figcaption>
                <span class="t-crest" aria-hidden="true">
                  {initials(t.name)}
                </span>
                <span>
                  <span class="t-name">{t.name}</span>
                  <span class="t-role">{t.role}</span>
                  <span class="t-context">{t.context}</span>
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )
}

<style>
  .t-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--gutter);
  }
  .t-grid.is-single {
    grid-template-columns: minmax(0, 1fr);
  }
  .t-grid.is-single .t-card {
    max-width: 880px;
  }

  .t-card {
    margin: 0;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: #fff;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .t-card blockquote p {
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.55;
    color: var(--heading);
  }
  .t-card figcaption {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .t-crest {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--accent-tint);
    color: var(--accent-deep);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .t-name,
  .t-role,
  .t-context {
    display: block;
  }
  .t-name {
    font-weight: 600;
    color: var(--heading);
  }
  .t-role,
  .t-context {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
</style>
